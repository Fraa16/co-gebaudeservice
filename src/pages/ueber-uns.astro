---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/sections/PageHero.astro';
import Statement from '../components/sections/Statement.astro';
import StatStrip from '../components/sections/StatStrip.astro';
import CtaBand from '../components/sections/CtaBand.astro';
import Photo from '../components/ui/Photo.astro';
import DraftNote from '../components/ui/DraftNote.astro';
import { ueberUns } from '../data/ueber-uns';
import { getPhoto } from '../data/photos';
import { company } from '../data/company';
import { pageSeo } from '../data/seo';
import { buildGraph } from '../lib/jsonld';

/** Rhythm: narrative. Opens on ink — the only page that does — then a full-width photo
 *  band, a single large statement with the prose beside it, the Einsatzgebiet as a
 *  place list, and a closing band. No index, no mosaic, no form. */
const seo = pageSeo.ueberUns;
const jsonLd = buildGraph({
  path: '/ueber-uns',
  title: seo.title,
  description: seo.description,
  pageType: 'AboutPage',
  breadcrumbs: [
    { name: 'Start', path: '/' },
    { name: 'Über uns', path: '/ueber-uns' },
  ],
});

/** TODO(client): confirm these places — draft, see CONTENT-REVIEW.md §3. */
const orte = ['Nagold', 'Altensteig', 'Wildberg', 'Haiterbach', 'Rohrdorf', 'Ebhausen'];

/** Only the slots that actually hold a photograph. */
const bandPhotos = ueberUns.photoBand.filter((slot) => getPhoto(slot).image);
---

<BaseLayout {...seo} path="/ueber-uns" jsonLd={jsonLd}>
  <PageHero
    pill={ueberUns.pill}
    pillNum="01"
    heading={ueberUns.h1}
    lead={ueberUns.lead}
    tone="ink"
    size="display"
  />

  {
    /* Four photographs in a row is the design. Four *placeholders* in a row is four
       broken images, which is what it looked like while the shots are outstanding —
       alternating the tone and the curve did not rescue it. So the band follows the
       data: it appears once real photographs exist, and until then a single wide
       panel stands in, which reads as a deliberate graphic rather than a gap.
       Nothing here changes when the shots land in src/data/photos.ts. */
    bandPhotos.length > 0 ? (
      <section class="about__band co-row-4" aria-hidden="true">
        {bandPhotos.map((slot, i) => (
          <div class="about__band-item co-reveal">
            <Photo
              slot={slot}
              sizes="(max-width: 700px) 50vw, 25vw"
              tone={(['blue', 'ice', 'ink', 'pale'] as const)[i % 4]}
              variant={i}
            />
          </div>
        ))}
      </section>
    ) : (
      <section class="about__band-single co-reveal" aria-hidden="true">
        <Photo slot={ueberUns.photoBand[0]!} sizes="100vw" tone="blue" />
      </section>
    )
  }

  <Statement
    kicker="Arbeitsweise"
    kickerNum="02"
    statement="Dieselben Gesichter im Haus, ein Ansprechpartner für die Verwaltung."
    paragraphs={ueberUns.paragraphs}
  >
    <DraftNote what="Absätze 2 und 3, Überschrift, Einleitung und die Ortsliste dieser Seite" />

    <div class="about__owner" slot="foot">
      <span class="about__owner-role">{company.ownerRole}</span>
      <span class="about__owner-name">{company.owner}</span>
      <span class="about__owner-place">{company.address.locality}</span>
    </div>
  </Statement>

  <section class="co-card co-card--ink co-grain about__facts">
    <p class="co-kicker"><span class="co-kicker__num">03</span> In Zahlen</p>
    <StatStrip stats={ueberUns.stats} />
  </section>

  <section class="co-card co-card--white about__area">
    <div class="about__area-head co-reveal">
      <p class="co-kicker"><span class="co-kicker__num">04</span> Einsatzgebiet</p>
      <h2 class="about__area-title">Kurze Wege, auch beim Winterdienst.</h2>
      <p class="about__area-text">{company.areaLong}</p>
    </div>
    <ul class="about__orte co-reveal">
      {orte.map((ort) => <li class="about__ort">{ort}</li>)}
    </ul>
  </section>

  <CtaBand
    heading="Objekt ansehen, Angebot erhalten."
    text="Kein Vertrag ohne Objektbesichtigung. Wir melden uns innerhalb von zwei Werktagen."
    cta={{ label: 'Angebot anfordern', href: '/kontakt' }}
    secondary={{ label: 'Alle Leistungen', href: '/leistungen' }}
  />
</BaseLayout>

<style>
  /* Photography immediately after the hero — this page leads with pictures, where
     /leistungen leads with a list. */
  .about__band-item {
    position: relative;
    overflow: hidden;
    min-width: 0;
    height: clamp(170px, 20vw, 260px);
    border-radius: var(--co-radius-photo);
    box-shadow: var(--co-shadow-card);
  }

  /* Stand-in while the four shots are outstanding: one wide panel, taller than a
     single band item so it holds the page's rhythm on its own. */
  .about__band-single {
    position: relative;
    overflow: hidden;
    min-width: 0;
    height: clamp(200px, 26vw, 340px);
    border-radius: var(--co-radius-photo);
    box-shadow: var(--co-shadow-card);
  }

  /* Who is actually behind the business, at the foot of the statement column. Facts
     from company.ts, not new marketing copy. */
  .about__owner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 6px;
    border-top: var(--co-rule);
    padding-top: 18px;
  }
  .about__owner-role {
    font: 600 10px/1 var(--co-font-body);
    letter-spacing: var(--co-label-tracking);
    text-transform: uppercase;
    color: var(--co-deep-text);
  }
  .about__owner-name {
    font: 600 clamp(18px, 1.6vw, 22px) / 1.2 var(--co-font-heading);
    letter-spacing: var(--co-h3-tracking);
    color: var(--co-ink);
  }
  .about__owner-place {
    font: 400 15px/1.4 var(--co-font-body);
    color: var(--co-muted);
  }

  .about__facts {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(22px, 3vw, 38px);
  }

  .about__area {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(26px, 4vw, 64px);
    align-items: center;
    justify-content: space-between;
  }
  .about__area-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
    flex: 1 1 min(400px, 100%);
    min-width: 0;
  }
  .about__area-title {
    font: 700 clamp(24px, 2.8vw, 38px) / 1.06 var(--co-font-heading);
    letter-spacing: var(--co-h2-tracking);
    max-width: 18ch;
  }
  .about__area-text {
    font: 400 16px/1.5 var(--co-font-body);
    color: var(--co-muted);
  }
  .about__orte {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    flex: 1 1 min(320px, 100%);
    min-width: 0;
  }
  .about__ort {
    border: 1px solid var(--co-line);
    border-radius: var(--co-radius-pill);
    padding: var(--co-chip-padding);
    font: 500 15px/1 var(--co-font-body);
    color: var(--co-ink);
    background: var(--co-mist);
  }
</style>
