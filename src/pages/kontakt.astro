---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/sections/ContactForm.astro';
import Timeline from '../components/sections/Timeline.astro';
import { company, contactRoutes } from '../data/company';
import { contact, detail } from '../data/content';
import { pageSeo } from '../data/seo';
import { buildGraph } from '../lib/jsonld';

/** Rhythm: direct. An ink band carrying the heading and all three contact routes at
 *  once, then the form with a slim aside, then what happens next. The homepage puts
 *  heading-and-rows beside the form; here the routes come first and the form gets the
 *  full card, because someone on this page has already decided to get in touch. */
const seo = pageSeo.kontakt;
const jsonLd = buildGraph({
  path: '/kontakt',
  title: seo.title,
  description: seo.description,
  pageType: 'ContactPage',
  breadcrumbs: [
    { name: 'Start', path: '/' },
    { name: 'Kontakt', path: '/kontakt' },
  ],
});

/** An unverified detail still renders — it is part of the design — but is not linked
 *  and never reaches structured data. See src/data/company.ts. */
const routes = contactRoutes;
const phone = contactRoutes.find((route) => route.label === 'Telefon');
---

<BaseLayout {...seo} path="/kontakt" jsonLd={jsonLd}>
  <section class="co-card co-card--ink co-grain reach">
    <div class="reach__head">
      <div class="reach__head-main">
        <p class="co-kicker"><span class="co-kicker__num">01</span> {contact.pill}</p>
        <h1 class="co-display reach__title">{contact.h2}</h1>
      </div>
      <p class="reach__lead">{contact.text}</p>
    </div>

    <div class="co-facts reach__routes">
      {
        routes.map((route) => (
          <div class="co-facts__item co-reveal">
            <span class="co-facts__label">{route.label}</span>
            {route.href ? (
              <a class="co-facts__value reach__route-link co-link-sweep" href={route.href}>
                {route.value}
              </a>
            ) : (
              <span class="co-facts__value">{route.value}</span>
            )}
          </div>
        ))
      }
    </div>
  </section>

  <section class="co-card co-card--white enquiry">
    <div class="enquiry__aside">
      <p class="co-kicker"><span class="co-kicker__num">02</span> Anfrage</p>
      <h2 class="enquiry__title">Sagen Sie uns kurz, um welches Objekt es geht.</h2>

      <dl class="enquiry__facts">
        <div class="enquiry__fact">
          <dt class="enquiry__fact-label">Rückmeldung</dt>
          <dd class="enquiry__fact-value">Innerhalb von zwei Werktagen</dd>
        </div>
        <div class="enquiry__fact">
          <dt class="enquiry__fact-label">Turnus</dt>
          <dd class="enquiry__fact-value">{detail.infoCard.facts[0]?.value}</dd>
        </div>
        <div class="enquiry__fact">
          <dt class="enquiry__fact-label">Einsatzgebiet</dt>
          <dd class="enquiry__fact-value">{company.areaLong}</dd>
        </div>
      </dl>

      {
        /* The form is tall and this column was not, leaving the lower third of the
           card blank. Someone who would rather talk than type is exactly who is
           looking at that space — so it holds the number, gated like every other
           contact detail. */
        phone && (
          <div class="enquiry__direct">
            <span class="enquiry__fact-label">{phone.label}</span>
            {phone.href ? (
              <a class="enquiry__direct-value co-link-sweep" href={phone.href}>
                {phone.value}
              </a>
            ) : (
              <span class="enquiry__direct-value">{phone.value}</span>
            )}
          </div>
        )
      }
    </div>

    <div class="enquiry__form">
      <ContactForm />
    </div>
  </section>

  <Timeline kickerNum="03" />
</BaseLayout>

<style>
  /* Ink opening: every way to reach us, before anything is asked of the reader. */
  .reach {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(30px, 4vw, 54px);
  }
  /* Heading and lead sit side by side once there is room. Stacked, the title's 16ch
     measure left the right half of a very large ink card empty. */
  .reach__head {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(18px, 3vw, 56px);
    align-items: flex-end;
  }
  .reach__head-main {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 18px;
    flex: 1 1 min(460px, 100%);
    min-width: 0;
  }
  .reach__title {
    font-size: clamp(30px, 4vw, 62px);
    max-width: 16ch;
  }
  .reach__lead {
    flex: 1 1 min(340px, 100%);
    min-width: 0;
    font: 400 clamp(16px, 1.4vw, 19px) / var(--co-lead-lh) var(--co-font-body);
    color: var(--co-ice);
    max-width: 46ch;
  }
  /* The three routes are a .co-facts row (global.css): hairline on the left when they
     sit side by side, hairline above once they stack. This rule is only the group's
     own separation from the lead above it. */
  .reach__routes {
    border-top: var(--co-rule-ink);
    padding-top: clamp(20px, 2.4vw, 32px);
  }
  a.reach__route-link:hover { color: var(--co-cyan); }

  /* The form takes the card; the aside is deliberately slim. */
  .enquiry {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(26px, 4vw, 60px);
    align-items: stretch;
  }
  .enquiry__aside {
    display: flex;
    flex-direction: column;
    gap: 18px;
    flex: 1 1 min(300px, 100%);
    min-width: 0;
  }
  /* Pushed to the foot of the column, whatever height the form takes. */
  .enquiry__direct {
    margin-top: auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 6px;
    border-top: var(--co-rule);
    padding-top: 18px;
  }
  .enquiry__direct-value {
    font: 600 clamp(18px, 1.7vw, 24px) / 1.2 var(--co-font-body);
    color: var(--co-ink);
  }
  a.enquiry__direct-value:hover { color: var(--co-blue); }
  .enquiry__title {
    font: 700 clamp(22px, 2.2vw, 32px) / 1.1 var(--co-font-heading);
    letter-spacing: var(--co-h2-tracking);
    max-width: 18ch;
  }
  .enquiry__facts {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 14px;
    margin: 0;
    border-top: var(--co-rule);
    padding-top: 18px;
  }
  .enquiry__fact {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 4px;
  }
  .enquiry__fact-label {
    font: 600 10px/1 var(--co-font-body);
    letter-spacing: var(--co-label-tracking);
    text-transform: uppercase;
    color: var(--co-deep-text);
  }
  .enquiry__fact-value {
    margin: 0;
    font: 400 16px/1.4 var(--co-font-body);
    color: var(--co-ink);
  }
  .enquiry__form {
    flex: 2 1 min(480px, 100%);
    min-width: 0;
    display: flex;
  }
  .enquiry__form > :global(form) { flex: 1 1 auto; }
</style>
