---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DetailChapter from '../../components/sections/DetailChapter.astro';
import Process from '../../components/sections/Process.astro';
import ContactSection from '../../components/sections/ContactSection.astro';
import { pageSeo } from '../../data/seo';
import { buildGraph, serviceNode } from '../../lib/jsonld';

const seo = pageSeo.treppenhausreinigung;
const path = '/leistungen/treppenhausreinigung';

const jsonLd = buildGraph({
  path,
  title: seo.title,
  description: seo.description,
  breadcrumbs: [
    { name: 'Start', path: '/' },
    { name: 'Leistungen', path: '/leistungen' },
    { name: 'Treppenhausreinigung', path },
  ],
  extra: [
    serviceNode({
      slug: 'treppenhausreinigung',
      name: 'Treppenhausreinigung',
      description: seo.description,
      url: path,
    }),
  ],
});
---

<BaseLayout {...seo} path={path} jsonLd={jsonLd}>
  <DetailChapter level={1} id="treppenhausreinigung" />
  <Process currentPath={path} />
  <ContactSection />
</BaseLayout>
