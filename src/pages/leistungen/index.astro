---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/sections/PageHero.astro';
import ServiceIndex from '../../components/sections/ServiceIndex.astro';
import ServiceRow from '../../components/sections/ServiceRow.astro';
import CtaBand from '../../components/sections/CtaBand.astro';
import Faq from '../../components/sections/Faq.astro';
import { allServices } from '../../data/services';
import { pages } from '../../data/pages';
import { faq } from '../../data/faq';
import { pageSeo } from '../../data/seo';
import { buildGraph, serviceCatalog, faqNode } from '../../lib/jsonld';

/** Rhythm: catalogue. Pale factual opening → typographic index of all eight →
 *  alternating editorial rows inside one document card → closing band.
 *  Deliberately no bento mosaic and no contact form: those belong to the homepage. */
const seo = pageSeo.leistungen;

/* All eight services reach structured data from here. Seven have no page of their own,
   so before this the graph advertised one service on a site that sells eight. */
const catalog = serviceCatalog('/leistungen', allServices);

const jsonLd = buildGraph({
  path: '/leistungen',
  title: seo.title,
  description: seo.description,
  pageType: 'CollectionPage',
  breadcrumbs: [
    { name: 'Start', path: '/' },
    { name: 'Leistungen', path: '/leistungen' },
  ],
  offerCatalogId: catalog.id,
  extra: [...catalog.nodes, faqNode('/leistungen', faq)],
});

const page = pages.leistungen;

/** The service count is derived, not written down, so it cannot drift from the
 *  catalogue. The rest of the row is copy and lives in src/data/pages.ts. */
const meta = [{ label: 'Leistungen', value: String(allServices.length) }, ...page.meta];
---

<BaseLayout {...seo} path="/leistungen" jsonLd={jsonLd}>
  <PageHero
    pill={page.pill}
    pillNum="01"
    heading={page.h1}
    lead={page.lead}
    size="display"
    meta={meta}
  />

  <ServiceIndex services={allServices} />

  <section class="co-card co-card--white leistungen__detail">
    {allServices.map((service, i) => <ServiceRow service={service} index={i} />)}
  </section>

  <Faq kickerNum="02" />

  <CtaBand
    heading={page.cta.heading}
    text={page.cta.text}
    cta={{ label: 'Angebot anfordern', href: '/kontakt#anfrage' }}
    secondary={{ label: 'Über uns', href: '/ueber-uns' }}
  />
</BaseLayout>

<style>
  /* One card holding all eight rows, so the page reads as a document rather than a
     grid of tiles. The rows draw their own hairline separators. */
  .leistungen__detail {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    padding-block: clamp(6px, 1vw, 18px);
  }
</style>
