---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import Schriftband from '../components/sections/Schriftband.astro';
import ServiceGrid from '../components/sections/ServiceGrid.astro';
import StatBand from '../components/sections/StatBand.astro';
import DetailChapter from '../components/sections/DetailChapter.astro';
import Process from '../components/sections/Process.astro';
import ContactSection from '../components/sections/ContactSection.astro';
import { homeServices, type Service } from '../data/services';
import { pageSeo } from '../data/seo';
import { buildGraph, howToNode } from '../lib/jsonld';
import { processContent } from '../data/content';

const seo = pageSeo.home;
const jsonLd = buildGraph({
  path: '/',
  title: seo.title,
  description: seo.description,
  extra: [
    howToNode('/', {
      name: processContent.h2,
      description: processContent.lead,
      steps: processContent.steps,
    }),
  ],
});
---

<BaseLayout {...seo} path="/" jsonLd={jsonLd}>
  <Hero />
  <StatBand />
  <Schriftband />
  <ServiceGrid services={homeServices} linkTo={(s: Service) => s.href ?? `/leistungen#${s.slug}`} />
  <DetailChapter />
  <Process currentPath="/" />
  <ContactSection />
</BaseLayout>
