---
interface Props {
  href?: string;
  type?: 'button' | 'submit';
  variant?: 'primary' | 'onPale' | 'onInk' | 'quiet';
  /** Circular arrow inside the pill, as on both reference sites. */
  arrow?: boolean;
  class?: string;
  id?: string;
}

const { href, type = 'button', variant = 'primary', arrow = false, class: cls, id } =
  Astro.props;
const classes = ['co-btn', `co-btn--${variant}`, arrow && 'co-btn--arrow', cls];
---

{
  href ? (
    <a class:list={classes} href={href} id={id}>
      <span class="co-btn__label">
        <slot />
      </span>
      {arrow && (
        <span class="co-btn__arrow" aria-hidden="true">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h13M12 5l7 7-7 7" />
          </svg>
        </span>
      )}
    </a>
  ) : (
    <button class:list={classes} type={type} id={id}>
      <span class="co-btn__label">
        <slot />
      </span>
      {arrow && (
        <span class="co-btn__arrow" aria-hidden="true">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h13M12 5l7 7-7 7" />
          </svg>
        </span>
      )}
    </button>
  )
}
