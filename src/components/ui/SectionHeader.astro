---
import PillLabel from './PillLabel.astro';
import Button from './Button.astro';

interface Props {
  pill: string;
  heading: string;
  level?: 1 | 2;
  lead?: string;
  cta?: { label: string; href: string; variant?: 'primary' | 'onInk' | 'quiet' };
  layout?: 'stack' | 'split';
  class?: string;
}

const { pill, heading, level = 2, lead, cta, layout = 'stack', class: cls } = Astro.props;
const Heading = level === 1 ? 'h1' : 'h2';
---

<div class:list={['section-header', `section-header--${layout}`, cls]}>
  <div class="section-header__text">
    <PillLabel text={pill} />
    <Heading class:list={['section-header__heading', level === 1 && 'is-h1']}>{heading}</Heading>
    {lead && <p class="section-header__lead">{lead}</p>}
  </div>
  {cta && (
    <Button href={cta.href} variant={cta.variant ?? 'primary'} class="section-header__cta">
      {cta.label}
    </Button>
  )}
</div>

<style>
  .section-header {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
  }
  .section-header--stack {
    flex-direction: column;
    align-items: flex-start;
  }
  .section-header--split {
    align-items: flex-end;
    justify-content: space-between;
  }
  .section-header__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    max-width: 640px;
  }
  .section-header__heading {
    font: 700 var(--co-h2-size) / 1.1 var(--co-font-heading);
    letter-spacing: var(--co-h2-tracking);
  }
  .section-header__heading.is-h1 {
    font-size: var(--co-h1-size);
    line-height: 1.06;
    letter-spacing: var(--co-h1-tracking);
  }
  .section-header__lead {
    font: 400 var(--co-body-size) / var(--co-lead-lh) var(--co-font-body);
    color: var(--co-muted);
  }
  :global(.co-card--ink) .section-header__lead {
    color: var(--co-ice);
  }
</style>
