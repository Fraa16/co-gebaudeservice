---
import { Image } from 'astro:assets';
import BrandPanel from './BrandPanel.astro';
import { getPhoto } from '../../data/photos';

/** Renders the real photograph when one exists for the slot, and a BrandPanel when it
 *  does not. src/data/photos.ts is the only thing that changes when the shots land. */
interface Props {
  slot: string;
  priority?: boolean;
  widths?: number[];
  sizes?: string;
  /** Overrides the slot's placeholder ground — used where several panels sit in a row. */
  tone?: 'ice' | 'pale' | 'blue' | 'ink';
  /** Picks a different swoosh so adjacent placeholders are not identical. */
  variant?: number;
  class?: string;
}

const {
  slot,
  priority = false,
  widths = [480, 800, 1200],
  sizes = '100vw',
  tone,
  variant = 0,
  class: cls,
} = Astro.props;
const photo = getPhoto(slot);
---

{
  photo.image ? (
    <Image
      class:list={['photo', cls]}
      src={photo.image}
      alt={photo.alt}
      widths={widths}
      sizes={sizes}
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
      decoding={priority ? 'sync' : 'async'}
    />
  ) : (
    <BrandPanel tone={tone ?? photo.tone} variant={variant} class={cls} />
  )
}

<style>
  .photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
