---
import Logo from './ui/Logo.astro';
import { callLabel, primaryNav } from '../data/nav';
import { company } from '../data/company';

interface Props {
  currentPath: string;
}
const { currentPath } = Astro.props;

const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);

const links = primaryNav.filter((i) => !i.primary);
const cta = primaryNav.find((i) => i.primary)!;
---

<header class="co-card--header site-header" data-site-header>
  <Logo href="/" height={50} markHeight={32} class="site-header__logo" />

  <!-- Wide: the links sit inline as pills. -->
  <nav class="site-header__inline" aria-label="Hauptnavigation">
    {
      links.map((item) => (
        <a
          class="co-nav-pill"
          href={item.href}
          aria-current={isActive(item.href) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))
    }
  </nav>

  <div class="site-header__end">
    <a class="co-nav-pill co-nav-pill--primary site-header__cta" href={cta.href}>{cta.label}</a>

    <!-- On a phone the number is one tap from the top of every page; the audit of
         5 Oct 2026 found it only in the footer and on /kontakt. Wide screens keep the
         pills and no button: a desktop rarely places the call itself. Gated like every
         other tel: link (CLAUDE.md rule 12). -->
    {
      company.phone.verified && (
        <a
          class="site-header__call"
          href={`tel:${company.phone.e164}`}
          aria-label={`${callLabel}: ${company.phone.display}`}
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
          </svg>
        </a>
      )
    }

    <!-- Narrow: the links collapse behind a disclosure. <details> needs no JavaScript,
         so the menu still opens if the script never runs (CLAUDE.md rule 10). -->
    <details class="site-header__menu">
      <summary class="site-header__toggle" aria-label="Menü öffnen">
        <span class="site-header__burger" aria-hidden="true"></span>
      </summary>
      <nav class="site-header__panel" aria-label="Hauptnavigation">
        {
          links.map((item) => (
            <a
              class="site-header__panel-link"
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))
        }
        <!-- The CTA moves in here only where the header itself has no room for it. -->
        <a class="site-header__panel-link site-header__panel-cta" href={cta.href}>{cta.label}</a>
      </nav>
    </details>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: var(--co-page-padding);
    z-index: 20;
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 12px 10px 16px;
    background: var(--co-glass-bg);
    border: 1px solid var(--co-glass-border);
    backdrop-filter: var(--co-glass-blur);
    transition: box-shadow 300ms ease, background-color 300ms ease, transform 260ms ease;
  }
  .site-header:global(.is-stuck) {
    background: var(--co-white);
    box-shadow: var(--co-shadow-card);
  }
  /* Set by scripts/reveal.ts on a short screen while scrolling down: out past the
     top edge, its own gutter included. Reduced motion drops the slide (tokens.css). */
  .site-header:global(.is-tucked) {
    transform: translateY(calc(-100% - var(--co-page-padding) - 2px));
  }

  .site-header__end {
    display: flex;
    align-items: center;
    gap: 8px;
    flex: none;
  }

  /* Inline links: hidden until the header has room for them. */
  .site-header__inline { display: none; }

  /* 44px, the size a thumb can hit without aiming — Apple's minimum, and the menu
     button's own size. On a phone the short logo is 32px tall and the CTA was 38px,
     so the three controls in the one row a visitor touches first were three sizes.
     The logo's rule is in global.css: it is a child component, so a scoped rule here
     never reaches it. */
  .site-header__cta {
    display: inline-flex;
    align-items: center;
    min-block-size: 44px;
    white-space: nowrap;
    padding: 0 16px;
  }

  /* The phone button: the menu button's twin, so the two read as one pair of tools. */
  .site-header__call {
    display: grid;
    place-items: center;
    flex: none;
    width: 44px;
    height: 44px;
    border: 1px solid var(--co-line);
    border-radius: var(--co-radius-pill);
    background: var(--co-white);
    color: var(--co-ink);
  }
  .site-header__call:hover { background: var(--co-mist); color: var(--co-ink); }
  .site-header__call svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Disclosure -------------------------------------------------------- */

  .site-header__menu { position: relative; flex: none; }

  .site-header__toggle {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--co-line);
    border-radius: var(--co-radius-pill);
    background: var(--co-white);
    cursor: pointer;
    list-style: none;
  }
  .site-header__toggle::-webkit-details-marker { display: none; }

  /* Three bars that become a cross when open. */
  .site-header__burger,
  .site-header__burger::before,
  .site-header__burger::after {
    content: '';
    display: block;
    width: 18px;
    height: 2px;
    border-radius: var(--co-radius-pill);
    background: var(--co-ink);
    transition: transform 220ms ease, opacity 160ms ease;
  }
  .site-header__burger::before { transform: translateY(-6px); }
  .site-header__burger::after { transform: translateY(4px); }
  [open] .site-header__burger { background: transparent; }
  [open] .site-header__burger::before { transform: translateY(0) rotate(45deg); }
  [open] .site-header__burger::after { transform: translateY(-2px) rotate(-45deg); }

  .site-header__panel {
    position: absolute;
    right: 0;
    top: calc(100% + 10px);
    min-width: 220px;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2px;
    padding: 8px;
    background: var(--co-white);
    border: 1px solid var(--co-line);
    border-radius: var(--co-radius-l);
    box-shadow: var(--co-shadow-lift);
  }
  .site-header__panel-link {
    display: flex;
    align-items: center;
    min-height: 46px;
    padding: 0 14px;
    border-radius: var(--co-radius-m);
    font: 500 16px/1 var(--co-font-body);
    color: var(--co-ink);
  }
  .site-header__panel-link:hover { background: var(--co-mist); color: var(--co-ink); }
  .site-header__panel-link[aria-current='page'] {
    background: var(--co-pale);
    color: var(--co-ink);
  }
  .site-header__panel-cta {
    display: none;
    justify-content: center;
    border-radius: var(--co-radius-pill);
    background: var(--co-ink);
    color: var(--co-white);
    font-weight: 600;
  }
  .site-header__panel-cta:hover { background: var(--co-blue); color: var(--co-white); }

  /* Where the header has no room for it, the CTA steps into the menu, as its last and
     only filled item, rather than shrinking into something hard to read. Logo, CTA,
     phone and menu need 338px of header, paddings and border included: a 360px phone
     has 340. Below that (a 320px phone, the 280px cover screen of a folded Galaxy
     Z Fold) the CTA goes, and the phone button stays, since on a phone it is the
     quicker route of the two. This was 300px before the phone button arrived; at 280px
     the CTA had hung the menu button 3px off the screen. */
  @container page (max-width: 337px) {
    .site-header__cta { display: none; }
    .site-header__panel-cta { display: flex; }
  }

  /* Once the header has room, swap the disclosure for inline pills. A container query,
     so it responds to the page column rather than the device. */
  @container page (min-width: 660px) {
    .site-header { padding: 14px 16px 14px 20px; gap: 14px; }
    .site-header__inline {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 8px;
    }
    .site-header__menu,
    .site-header__call { display: none; }
    /* Back to the nav pills' own size, so the CTA lines up with them; global.css
       gives every pill its 44px hit area. */
    .site-header__cta {
      min-block-size: 0;
      padding: var(--co-nav-pill-padding);
    }
  }
</style>
