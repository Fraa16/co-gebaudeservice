---
import { allServices } from '../../data/services';
import { company } from '../../data/company';

/** The reference stat band: large figures separated by hairlines. Every value is
 *  factual rather than an invented metric; the CI tonality rule forbids claims we
 *  cannot stand behind.
 *
 *  Two of the four used to be read out of a list by position: `areaServed[1]` and
 *  `detail.infoCard.facts[0]`. Both broke silently. Extending the Einsatzgebiet to ten
 *  towns turned the "Einsatzgebiet" figure into "Ebhausen" — the second town in the
 *  array — and the Turnus figure was "Wöchentlich oder 14-tägig", which is a sentence
 *  where the band wants a headline. Positional access into copy is how a display value
 *  changes without anyone editing the display. These are written out.
 *
 *  Values stay short because this row sets them at up to 34px. Detail belongs in the
 *  label underneath, at 14px, which is why the Turnus reads the other way round now. */
const stats = [
  { value: String(allServices.length), label: 'Leistungsbereiche' },
  { value: 'Fester Turnus', label: 'Wöchentlich oder 14-tägig' },
  { value: company.district, label: 'Einsatzgebiet' },
  { value: 'Zwei Werktage', label: 'Rückmeldung auf Anfragen' },
];
---

<section class="co-card--xl stat-band co-row-4 co-row-4--divided">
  {
    stats.map((stat) => (
      <div class="stat-band__item co-reveal">
        <p class="stat-band__value">{stat.value}</p>
        <p class="stat-band__label">{stat.label}</p>
      </div>
    ))
  }
</section>

<style>
  .stat-band {
    background: var(--co-white);
    padding: clamp(26px, 3.2vw, 46px) clamp(22px, 2.6vw, 40px);
  }
  .stat-band__item {
    min-width: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 8px;
    align-content: start;
  }
  .stat-band__value {
    /* Two rows' worth, so a value that wraps does not drop its label below the
       others' baseline. */
    min-height: calc(2 * 1.05em);
    font: 700 clamp(22px, 2.2vw, 34px) / 1.05 var(--co-font-heading);
    letter-spacing: var(--co-h2-tracking);
    color: var(--co-ink);
    text-wrap: balance;
  }
  .stat-band__label {
    font: 400 14px/1.4 var(--co-font-body);
    color: var(--co-muted);
  }
</style>
