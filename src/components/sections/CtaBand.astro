---
import Button from '../ui/Button.astro';

/** A compact closing call to action. Deliberately not the full ContactSection: only
 *  the homepage and /kontakt carry the form, so the inner pages end with a short band
 *  instead of repeating the same block on every page. */
interface Props {
  heading: string;
  text?: string;
  cta: { label: string; href: string };
  secondary?: { label: string; href: string };
}
const { heading, text, cta, secondary } = Astro.props;
---

<section class="co-card co-card--ink co-grain cta-band">
  <div class="cta-band__text co-reveal">
    <h2 class="cta-band__heading">{heading}</h2>
    {text && <p class="cta-band__body">{text}</p>}
  </div>

  <div class="cta-band__actions co-reveal">
    <Button href={cta.href} variant="onInk" arrow>{cta.label}</Button>
    {secondary && <Button href={secondary.href} variant="quiet">{secondary.label}</Button>}
  </div>
</section>

<style>
  .cta-band {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: clamp(24px, 3vw, 48px);
    overflow: hidden;
  }

  /* The signature at the foot of an inner page: the mark's letters, oversized and cut
     by the card's own edge, the way the step cards carry ghost numerals and the footer
     its ghost wordmark. A pseudo-element rather than an <img>, so it never enters the
     accessibility tree and needs no aria-hidden. */
  .cta-band::after {
    content: '';
    position: absolute;
    right: -4%;
    top: 50%;
    translate: 0 -50%;
    z-index: 0;
    width: min(46%, 380px);
    aspect-ratio: 1311 / 795;
    background: url('/co-invert.svg') center / contain no-repeat;
    opacity: 0.09;
    pointer-events: none;
  }
  /* Above the ghost. */
  .cta-band__text,
  .cta-band__actions {
    position: relative;
    z-index: 1;
  }
  .cta-band__text {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 14px;
    flex: 1 1 min(460px, 100%);
    min-width: 0;
  }
  .cta-band__heading {
    font: 700 clamp(26px, 3.2vw, 44px) / 1.04 var(--co-font-heading);
    letter-spacing: var(--co-h2-tracking);
    max-width: 20ch;
  }
  .cta-band__body {
    font: 400 clamp(16px, 1.35vw, 18px) / 1.55 var(--co-font-body);
    color: var(--co-ice);
    max-width: 46ch;
  }
  .cta-band__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
</style>
