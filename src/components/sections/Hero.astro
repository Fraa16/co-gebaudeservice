---
import Button from '../ui/Button.astro';
import Photo from '../ui/Photo.astro';
import { hero, detail } from '../../data/content';
import { company } from '../../data/company';
import { resolveHref } from '../../data/routes';

/** Full-bleed photography inside the rounded container, display type held on the
 *  left by a scrim, and two panels floating over the bottom corners — the
 *  composition both reference heroes use. */
const facts = [
  { label: 'Einsatzgebiet', value: company.areaLong },
  { label: 'Turnus', value: detail.infoCard.facts[0]?.value ?? '' },
];
---

<section class="co-card--xl co-grain hero" id="hero">
  <div class="hero__media">
    <!-- Up to the source's own 1672px, and `sizes` says how large it really renders:
         from 720px on the photo is enlarged 1.4 to 1.8 times (see the styles below),
         so "100vw" had the browser fetch a width it then upscaled. -->
    <Photo
      slot="r-hero"
      priority
      sizes="(min-width: 760px) 160vw, 100vw"
      widths={[480, 800, 1200, 1672]}
    />
  </div>
  <div class="hero__scrim" aria-hidden="true"></div>
  <div class="hero__scrim-v" aria-hidden="true"></div>

  <div class="hero__body">
    <p class="hero__pill co-reveal">
      <span class="hero__dot" aria-hidden="true"></span>
      <span class="hero__pill-text">{hero.locationPill}</span>
    </p>

    <h1 class="co-display hero__title co-reveal">{hero.h1}</h1>

    <p class="hero__sub co-reveal">{hero.sub}</p>

    <div class="hero__actions co-reveal">
      <Button href={resolveHref(hero.primaryCta.href)} variant="primary" arrow>
        {hero.primaryCta.label}
      </Button>
      <Button href={resolveHref(hero.secondaryCta.href)} variant="onPale">
        {hero.secondaryCta.label}
      </Button>
    </div>
  </div>

  <div class="hero__float hero__float--left co-reveal">
    {
      facts.map((fact) => (
        <div class="hero__fact">
          <span class="hero__fact-label">{fact.label}</span>
          <span class="hero__fact-value">{fact.value}</span>
        </div>
      ))
    }
  </div>

  <a class="hero__float hero__float--right co-reveal" href="/leistungen">
    <span class="hero__float-arrow" aria-hidden="true">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
        stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M7 17 17 7M9 7h8v8"></path>
      </svg>
    </span>
    <span class="hero__float-text">
      <span class="hero__float-title">Acht Leistungen</span>
      <span class="hero__float-meta">Alles ansehen</span>
    </span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    background: var(--co-pale);
  }
  /* Narrow first. On a phone the text runs the full width of the hero, so a photo
     behind it needs a veil strong enough for dark type over his navy shirt — .84 of
     the pale ground — and under that veil the photograph was a pale smear: the one
     picture the client chose for the top of the site, and phones never saw it. So
     below 720px it is not behind the text at all. It follows the text as a framed
     photograph of its own, with the facts panel floating over its lower edge the way
     both panels float over the photo's corners on a wide screen. No text crosses it,
     so it needs no scrim. */
  .hero__media {
    position: relative;
    order: 1;
    margin: 0 clamp(12px, 2vw, 28px);
    aspect-ratio: 4 / 3;
    border-radius: var(--co-radius-l);
    overflow: hidden;
  }
  /* 4:3 shows three quarters of the 1.78:1 frame's width and all of its height: he
     stands just left of centre, so the crop keeps him and his cart whole. */
  .hero__media :global(.photo) { object-position: 45% 30%; }
  .hero__scrim,
  .hero__scrim-v {
    display: none;
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .hero__scrim { background: var(--co-hero-scrim); }
  .hero__scrim-v { background: var(--co-hero-scrim-v); }

  .hero__body {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
    padding: clamp(26px, 5vw, 76px);
    max-width: min(100%, 900px);
  }
  .hero__pill {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    background: var(--co-glass-bg);
    border: 1px solid var(--co-glass-border);
    backdrop-filter: var(--co-glass-blur);
    border-radius: var(--co-radius-pill);
    padding: 9px 16px;
  }
  .hero__dot {
    flex: none;
    width: 7px;
    height: 7px;
    border-radius: var(--co-radius-pill);
    background: var(--co-blue);
  }
  .hero__pill-text {
    font: 600 11px/1 var(--co-font-body);
    letter-spacing: var(--co-label-tracking);
    text-transform: uppercase;
    color: var(--co-ink);
  }
  .hero__title { max-width: 20ch; }
  .hero__sub {
    font: 400 clamp(17px, 1.5vw, 20px) / var(--co-lead-lh) var(--co-font-body);
    color: var(--co-deep-text);
    max-width: 46ch;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 8px;
  }

  /* Panels floating over the bottom corners of the container. */
  .hero__float {
    position: relative;
    z-index: 1;
    margin: 0 clamp(12px, 2vw, 28px);
    background: var(--co-glass-bg);
    border: 1px solid var(--co-glass-border);
    backdrop-filter: var(--co-glass-blur);
    border-radius: var(--co-radius-l);
    box-shadow: var(--co-shadow-card);
  }
  .hero__float--left {
    order: 2;
    display: flex;
    flex-wrap: wrap;
    padding: clamp(14px, 1.6vw, 22px) clamp(16px, 2vw, 26px);
    gap: clamp(14px, 2vw, 30px);
    /* Pulled up over the photograph's lower edge and held inside its frame. */
    margin: -52px clamp(24px, 4vw, 44px) clamp(12px, 2vw, 28px);
  }
  .hero__fact {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 5px;
  }
  .hero__fact-label {
    font: 600 11px/1 var(--co-font-body);
    letter-spacing: var(--co-label-tracking);
    text-transform: uppercase;
    color: var(--co-blue);
  }
  .hero__fact-value {
    font: 600 clamp(14px, 1.3vw, 17px) / 1.25 var(--co-font-body);
    color: var(--co-ink);
  }

  /* On a phone this sat directly under "Leistungen ansehen", a second link to the
     same page one thumb's width below the first. It returns with the wide layout,
     where it is a panel on the photograph rather than a repeat of a button. */
  .hero__float--right {
    display: none;
    margin-bottom: clamp(14px, 2vw, 28px);
    align-items: center;
    gap: 14px;
    padding: clamp(14px, 1.4vw, 18px) clamp(18px, 2vw, 24px);
    transition: box-shadow 220ms ease, transform 220ms ease;
  }
  .hero__float--right:hover {
    box-shadow: var(--co-shadow-lift);
    transform: translateY(-2px);
  }
  .hero__float-arrow {
    flex: none;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: var(--co-radius-pill);
    background: var(--co-ink);
    color: var(--co-white);
  }
  .hero__float-text { display: grid; gap: 3px; }
  .hero__float-title {
    font: 600 15px/1.2 var(--co-font-body);
    color: var(--co-ink);
  }
  .hero__float-meta {
    font: 400 12px/1 var(--co-font-body);
    color: var(--co-muted);
  }

  /* A large phone or a small tablet in portrait: 4:3 across 700px of width is a
     photograph taller than the headline, buttons and lead together. 16:10 still keeps
     him and the cart whole — the frame is only a little narrower than the photo's own
     1.78:1. */
  @container page (min-width: 480px) {
    .hero__media { aspect-ratio: 16 / 10; }
  }

  /* Wide enough to float the panels over the corners without hitting the CTAs. */
  @container page (min-width: 720px) {
    .hero {
      align-content: center;
      min-height: clamp(500px, 66vh, 720px);
    }
    .hero__body { padding-bottom: clamp(120px, 14vw, 180px); }
    /* The photograph goes back behind everything, full bleed. */
    .hero__media {
      position: absolute;
      inset: 0;
      margin: 0;
      aspect-ratio: auto;
      border-radius: 0;
    }
    .hero__media :global(.photo) { object-position: 50% 50%; }
    .hero__scrim,
    .hero__scrim-v { display: block; }
    .hero__float {
      position: absolute;
      bottom: clamp(16px, 2vw, 28px);
      margin: 0;
    }
    .hero__float--left { left: clamp(16px, 2vw, 28px); }
    .hero__float--right {
      display: flex;
      right: clamp(16px, 2vw, 28px);
    }

    /* The hero holds its type on the left, so it wants a photo whose subject stands
       right of centre. The Hausmeisterdienst shot has him left of centre, and at
       full frame the headline ran straight across his face. The frame (about 1.8:1)
       is as wide as the photo (1.78:1), so object-position has no slack to move him;
       enlarging from the left edge does, and puts him beside the headline. Tuned for
       this photograph: a new hero photo should be checked against it. */
    .hero__media :global(.photo) {
      transform: scale(1.8);
      transform-origin: 0 10%;
    }
  }
  /* The headline takes a smaller share of a wider hero, so less enlargement is
     needed as it grows — and less means sharper. Each step is the least that keeps
     "in" off his cap and "festem" off his face at the narrow end of its range. */
  @container page (min-width: 960px) {
    .hero__media :global(.photo) { transform: scale(1.55); }
  }
  @container page (min-width: 1200px) {
    .hero__media :global(.photo) { transform: scale(1.4); }
  }
</style>
