---
/** A bento mosaic, not an even grid: tiles vary in width and height, the first is a
 *  feature spanning two columns. This is the single biggest difference between the
 *  reference sites and a template.
 *
 *  Every service with a photograph carries it. Until September 2026 only the feature
 *  tile did and the rest were flat brand grounds — a stand-in variety for a site with
 *  one photo. With a photo per service the variety comes from the photographs and the
 *  tile sizes; the recipe's tones stay as the fallback for a service without one, and
 *  the closing CTA card keeps the one solid ink ground. */
import ServiceCard from './ServiceCard.astro';
import ServicesCtaCard from './ServicesCtaCard.astro';
import Button from '../ui/Button.astro';
import type { Service } from '../../data/services';
import { pages } from '../../data/pages';
import { getPhoto } from '../../data/photos';

type LinkResolver = (service: Service) => string | undefined;

interface Props {
  services: Service[];
  linkTo?: LinkResolver;
}
/** `as Props` rather than plain destructuring: Astro does not bind the Props interface
 *  in this particular file — TypeScript reports it as "declared but never used" and
 *  Astro.props falls back to Record<string, any>. Every construct in here binds
 *  correctly in isolation, so it is a compiler quirk rather than a mistake in the
 *  source. Asserting the contract restores types inside the component; it does not
 *  type-check the caller, which is the one thing lost. */
const { services, linkTo } = Astro.props as Props;

/** Tile recipe by position. Varied deliberately — never a repeating pattern. `tone`
 *  applies only when the service has no photograph. */
const RECIPE = [
  { size: 'feature', tone: 'photo', span: 'wide' },
  { size: 'standard', tone: 'ink', span: 'narrow' },
  { size: 'standard', tone: 'blue', span: 'narrow' },
  { size: 'tall', tone: 'pale', span: 'narrow' },
  { size: 'standard', tone: 'blue', span: 'wide' },
] as const;
---

<section class="leistungen" id="leistungen">
  <header class="leistungen__head">
    <div class="leistungen__head-text co-reveal">
      <p class="co-kicker"><span class="co-kicker__num">01</span> Leistungen</p>
      <h2 class="leistungen__title">{pages.home.servicesHeading}</h2>
    </div>
    <Button href="/leistungen" variant="quiet" arrow class="co-reveal">Alle acht Leistungen</Button>
  </header>

  <div class="leistungen__grid">
    {
      services.map((service, i) => {
        const recipe = RECIPE[i % RECIPE.length]!;
        const hasPhoto = Boolean(getPhoto(service.photoSlot).image);
        return (
          <div class:list={['leistungen__cell', `is-${recipe.span}`, 'co-reveal']}>
            <ServiceCard
              service={service}
              href={linkTo?.(service)}
              size={recipe.size}
              tone={hasPhoto ? 'photo' : recipe.tone}
              photoSizes={
                recipe.span === 'wide'
                  ? '(max-width: 760px) 100vw, 55vw'
                  : '(max-width: 760px) 100vw, 30vw'
              }
              index={i}
            />
          </div>
        );
      })
    }
    <div class="leistungen__cell is-cta co-reveal">
      <ServicesCtaCard />
    </div>
  </div>
</section>

<style>
  .leistungen {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(22px, 3vw, 40px);
  }
  /* Below 960px the Schriftband is hidden (Schriftband.astro), and this section, which
     is not a card, would start one 10px gutter under the stat band, its kicker pressed
     against the card above. The air the band used to give comes back as padding. */
  @container main (max-width: 959px) {
    .leistungen { padding-top: clamp(18px, 3vw, 30px); }
  }
  /* Heading left, CTA right on one baseline. */
  .leistungen__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    padding: 0 clamp(4px, 1vw, 12px);
  }
  .leistungen__head-text {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
    flex: 1 1 min(520px, 100%);
    min-width: 0;
    max-width: min(46ch, 100%);
  }
  .leistungen__title {
    font: 700 var(--co-h2-size) / 1.02 var(--co-font-heading);
    letter-spacing: var(--co-h2-tracking);
  }

  /* Fluid mosaic: cells claim different widths but still wrap on their own, so
     the asymmetry needs no breakpoint. */
  .leistungen__grid {
    display: flex;
    flex-wrap: wrap;
    gap: var(--co-card-gap);
  }
  .leistungen__cell {
    display: flex;
    min-width: 0;
    /* The cell must carry the height itself: a min-height on the tile alone is
       resolved against the flex line and collapses to the row height. */
    align-items: stretch;
  }
  .is-wide { min-height: clamp(340px, 32vw, 470px); }
  .is-narrow { min-height: clamp(260px, 24vw, 330px); }
  .leistungen__cell > :global(*) { flex: 1 1 auto; }
  .is-wide { flex: 2 1 min(620px, 100%); }
  .is-narrow { flex: 1 1 min(310px, 100%); }
  /* Sized like a narrow tile, but without a tile's minimum height: it has no photo to
     show, so alone on a row it should be as tall as its text and no taller. */
  .is-cta { flex: 1 1 min(310px, 100%); }
</style>
