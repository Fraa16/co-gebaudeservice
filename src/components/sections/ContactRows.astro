---
import { contactRoutes } from '../../data/company';

/** An unverified detail still renders — it is part of the design — but it is not
 *  linked, because nobody should dial or mail a placeholder. Both the value and the
 *  link come from contactRoutes, so they cannot disagree. */
const rows = contactRoutes;
---

<div class="contact-rows">
  {
    rows.map((row) => (
      <div class="contact-row">
        <span class="contact-row__label">{row.label}</span>
        <span class="contact-row__detail">
          {row.href ? (
            <a class="contact-row__value" href={row.href}>
              {row.value}
            </a>
          ) : (
            <span class="contact-row__value">{row.value}</span>
          )}
          {row.note && <span class="contact-row__note">{row.note}</span>}
        </span>
      </div>
    ))
  }
</div>

<style>
  .contact-rows {
    display: grid;
    gap: 10px;
  }
  .contact-row {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px;
    background: var(--co-mist);
    border-radius: var(--co-radius-contact-row);
    padding: 18px 22px;
  }
  .contact-row__label {
    font: 600 11px/1 var(--co-font-body);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--co-blue);
  }
  .contact-row__value {
    font: 400 17px/1.3 var(--co-font-body);
    color: var(--co-ink);
  }
  a.contact-row__value:hover {
    color: var(--co-blue);
  }
  /* The row is the target, not the 22px of text in it: it is drawn as one pill, so a
     tap anywhere on "Telefon … 0172 3001489" should dial. */
  a.contact-row__value::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  /* Value and its note stack at the row's right edge, so the hours sit directly under
     the number they belong to. */
  .contact-row__detail {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: end;
    gap: 3px;
    min-width: 0;
    text-align: right;
  }
  .contact-row__note {
    font: 400 14px/1.35 var(--co-font-body);
    color: var(--co-muted);
    text-wrap: pretty;
  }
</style>
