---
import type { Service } from '../../data/services';

/** The Leistungen page's signature device: every service as a full-width typographic
 *  row, hairline-separated, rather than another grid of cards. Deliberately the
 *  opposite texture to the homepage's bento mosaic — this page is a catalogue, so it
 *  reads as an index, not a showcase. */
interface Props {
  services: Service[];
}
const { services } = Astro.props;
---

<section class="co-card co-card--white index">
  <ol class="index__list">
    {
      services.map((service, i) => (
        <li class="index__row co-reveal">
          <a class="index__link" href={`#${service.slug}`}>
            <span class="index__num">{String(i + 1).padStart(2, '0')}</span>
            <span class="index__title">{service.title}</span>
            <span class="index__turnus">{service.turnus}</span>
            <span class="index__arrow" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h13M12 5l7 7-7 7" />
              </svg>
            </span>
          </a>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .index {
    padding: clamp(18px, 2.4vw, 34px) clamp(18px, 2.6vw, 40px);
  }
  .index__list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }
  .index__row + .index__row {
    border-top: var(--co-rule);
  }
  /* A grid with named places rather than a wrapping flex row. Wrapped, the turnus and
     the arrow fell onto a second line as a pair, so on a phone the arrow sat wherever
     that row's turnus happened to end: 60px in on one row, 290px on the next, on a
     line of its own on a third.
     Narrowest first: number and arrow share the top line, and the name gets the full
     width beneath them. With the number and arrow beside it instead, the name had
     159px on a 320px phone and "Treppenhausreinigung" needs 207, so it broke as
     "Treppenhausrein | igung". */
  .index__link {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      'num    arrow'
      'title  title'
      'turnus turnus';
    align-items: center;
    gap: 6px clamp(12px, 2vw, 28px);
    padding: clamp(16px, 1.8vw, 26px) clamp(8px, 1vw, 16px);
    color: var(--co-ink);
    border-radius: var(--co-radius-m);
    transition: background-color 260ms ease, padding-left 260ms ease;
  }
  /* From about a 380px phone up the name fits beside them: number left, arrow in a
     column of its own at the right edge, centred against the two lines. */
  @container main (min-width: 360px) {
    .index__link {
      grid-template-columns: 3.4ch minmax(0, 1fr) auto;
      grid-template-areas:
        'num title  arrow'
        '.   turnus arrow';
      align-items: baseline;
    }
  }
  .index__link:hover {
    background: var(--co-mist);
    padding-left: clamp(14px, 1.8vw, 26px);
    color: var(--co-ink);
  }
  .index__num {
    grid-area: num;
    /* Wide enough for "01" plus its tracking — 2.6ch wrapped the digits onto two
       lines once letter-spacing was applied. The column is 3.4ch for that reason. */
    white-space: nowrap;
    font: 600 12px/1 var(--co-font-body);
    font-variant-numeric: tabular-nums;
    letter-spacing: var(--co-label-tracking);
    color: var(--co-deep-text);
  }
  .index__title {
    grid-area: title;
    min-width: 0;
    /* 21px at a 390px phone to 32px at 1440, with an intercept (CLAUDE.md rule 6):
       clamp(21px, 2.4vw, 32px) sat on its floor up to an 875px viewport. */
    font: 600 clamp(19px, 16.92px + 1.048vw, 32px) / 1.1 var(--co-font-heading);
    letter-spacing: var(--co-h3-tracking);
  }
  .index__turnus {
    grid-area: turnus;
    font: 400 14px/1.4 var(--co-font-body);
    color: var(--co-muted);
  }
  .index__arrow {
    grid-area: arrow;
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    align-self: center;
    border-radius: var(--co-radius-pill);
    color: var(--co-deep-text);
    transition: background-color 240ms ease, color 240ms ease, transform 260ms ease;
  }
  .index__link:hover .index__arrow {
    background: var(--co-ink);
    color: var(--co-white);
    transform: translateX(3px);
  }

  /* Once there is room, one line per service: number, name, turnus, arrow. */
  @container main (min-width: 720px) {
    .index__link {
      grid-template-columns: 3.4ch minmax(0, 1fr) auto auto;
      grid-template-areas: 'num title turnus arrow';
    }
    .index__turnus { text-align: right; }
  }
</style>
