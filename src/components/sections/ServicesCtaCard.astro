---
import Button from '../ui/Button.astro';
import PillLabel from '../ui/PillLabel.astro';
import { servicesCta } from '../../data/content';
import { resolveHref } from '../../data/routes';
---

<article class="co-card--l co-card--ink services-cta">
  <div class="services-cta__text">
    <PillLabel text={servicesCta.pill} />
    <h3 class="services-cta__title">{servicesCta.title}</h3>
    <p class="services-cta__body">{servicesCta.text}</p>
  </div>
  <Button href={resolveHref(servicesCta.cta.href)} variant="onInk">
    {servicesCta.cta.label}
  </Button>
</article>

<style>
  .services-cta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: space-between;
    gap: 22px;
    min-height: clamp(300px, 26vw, 370px);
    padding: var(--co-small-card-padding);
  }
  .services-cta__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    width: 100%;
  }
  .services-cta__title {
    font: 600 clamp(20px, 2.2vw, 26px) / 1.18 var(--co-font-heading);
    letter-spacing: var(--co-h3-tracking);
  }
  .services-cta__body {
    font: 400 15px/1.5 var(--co-font-body);
    color: var(--co-ice);
  }
</style>
