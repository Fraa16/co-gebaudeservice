---
import SectionHeader from '../ui/SectionHeader.astro';
import ContactRows from './ContactRows.astro';
import ContactForm from './ContactForm.astro';
import { contact } from '../../data/content';

interface Props {
  level?: 1 | 2;
  id?: string;
}
const { level = 2, id = 'kontakt' } = Astro.props;
---

<section class="co-card co-card--white contact-section" id={id}>
  <div class="contact-section__grid">
    <div class="contact-section__intro">
      <SectionHeader pill={contact.pill} heading={contact.h2} level={level} />
      <p class="contact-section__text">{contact.text}</p>
      <ContactRows />
      <slot name="extras" />
    </div>

    <ContactForm />
  </div>
</section>

<style>
  .contact-section__grid {
    display: grid;
    grid-template-columns: var(--co-grid-two-col);
    gap: var(--co-two-col-gap);
    align-items: start;
  }
  .contact-section__intro {
    display: grid;
    gap: 20px;
  }
  .contact-section__text {
    font: 400 var(--co-body-size) / var(--co-body-lh) var(--co-font-body);
    color: var(--co-muted);
    max-width: 420px;
  }
</style>
