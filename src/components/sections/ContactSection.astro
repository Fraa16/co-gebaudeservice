---
import ContactRows from './ContactRows.astro';
import ContactForm from './ContactForm.astro';
import { contact } from '../../data/content';

interface Props {
  level?: 1 | 2;
  id?: string;
}
const { level = 2, id = 'kontakt' } = Astro.props;
---

<section class="co-card co-card--white contact-section" id={id}>
  <div class="contact-section__grid">
    <div class="contact-section__intro">
      <p class="co-kicker"><span class="co-kicker__num">04</span> {contact.pill}</p>
      {level === 1
        ? <h1 class="co-display contact-section__heading">{contact.h2}</h1>
        : <h2 class="co-display contact-section__heading">{contact.h2}</h2>}
      <p class="contact-section__text">{contact.text}</p>
      <ContactRows />
      <slot name="extras" />
    </div>

    <ContactForm />
  </div>
</section>

<style>
  .contact-section__grid {
    display: flex;
    flex-wrap: wrap;
    gap: var(--co-two-col-gap);
    align-items: flex-start;
  }
  .contact-section__intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 20px;
    flex: 1 1 min(460px, 100%);
    min-width: 0;
  }
  .contact-section__heading {
    font-size: clamp(30px, 3.4vw, 52px);
    max-width: 16ch;
  }
  .contact-section__grid > :global(form) {
    flex: 1 1 min(440px, 100%);
    min-width: 0;
  }
  .contact-section__text {
    font: 400 var(--co-body-size) / var(--co-body-lh) var(--co-font-body);
    color: var(--co-muted);
    max-width: 420px;
  }
</style>
