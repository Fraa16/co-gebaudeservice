---
/** One tile of the bento mosaic. `size` sets the tile's height; `tone` its ground —
 *  a photograph under a scrim, or a flat brand ground with a watermark for a service
 *  that has no photo yet. ServiceGrid decides which. */
import Photo from '../ui/Photo.astro';
import type { Service } from '../../data/services';
import { fitStyle } from '../../lib/fit';

interface Props {
  service: Service;
  href?: string;
  size?: 'feature' | 'tall' | 'standard';
  tone?: 'photo' | 'ink' | 'pale' | 'blue';
  /** The `sizes` attribute for the photograph. A narrow tile is about a third of the
   *  row, and telling the browser 55vw there made it fetch the next width up. */
  photoSizes?: string;
  index?: number;
}
const {
  service,
  href,
  size = 'standard',
  tone = 'blue',
  photoSizes = '(max-width: 760px) 100vw, 55vw',
  index = 0,
} = Astro.props;
const num = String(index + 1).padStart(2, '0');
---

<article
  class:list={[
    'co-card--l co-grain tile',
    `tile--${size}`,
    `tile--${tone}`,
    href && 'is-linked',
  ]}
  id={service.slug}
>
  {tone === 'photo' && <Photo slot={service.photoSlot} sizes={photoSizes} variant={index} />}
  {tone === 'photo' && <div class="co-scrim" aria-hidden="true"></div>}

  {tone !== 'photo' && (
    <svg class="tile__watermark" viewBox="0 0 200 200" aria-hidden="true" preserveAspectRatio="xMaxYMax slice">
      <path d="M-20 150 C 40 60, 110 190, 230 70" fill="none" stroke="currentColor"
        stroke-width="34" stroke-linecap="round" opacity="0.13"></path>
    </svg>
  )}

  <div class="tile__top">
    <span class="tile__num">{num}</span>
    <span class="tile__chip">{service.chip}</span>
  </div>

  <div class="tile__body">
    <h3 class="tile__title co-fit" style={fitStyle(service.title)}>
      {href ? <a href={href}>{service.title}</a> : service.title}
    </h3>
    <p class="tile__text">{service.text}</p>
  </div>

  {href && (
    <span class="tile__arrow" aria-hidden="true">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
        stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M7 17 17 7M9 7h8v8"></path>
      </svg>
    </span>
  )}
</article>

<style>
  .tile {
    position: relative;
    /* A stacking context of its own, so the photograph, scrim and grain can sit at
       z-index -1 — under the text but above the tile's ground — without positioning
       the text. See .tile__title a::after for why the text must stay unpositioned. */
    isolation: isolate;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    /* Heading top, body bottom with the gap pushed between them — the vertical
       spread both references use inside cards. */
    justify-content: space-between;
    gap: clamp(40px, 8vw, 90px);
    padding: clamp(22px, 2.4vw, 32px);
    min-height: clamp(260px, 24vw, 330px);
    transition: box-shadow 300ms ease, transform 300ms ease;
  }
  .tile--feature { min-height: clamp(320px, 34vw, 460px); }
  .tile--tall { min-height: clamp(300px, 30vw, 420px); }

  .tile--blue { background: var(--co-blue); color: var(--co-white); }
  .tile--ink { background: var(--co-ink-gradient); color: var(--co-white); }
  .tile--pale { background: var(--co-pale-gradient); color: var(--co-ink); }
  .tile--photo { background: var(--co-blue); color: var(--co-white); }

  .tile.is-linked:hover {
    box-shadow: var(--co-shadow-lift);
    transform: translateY(-3px);
  }

  /* Quiet brand mark, bottom-right. At 78% it read as a random blob rather than
     the logo swoosh. */
  .tile__watermark {
    position: absolute;
    right: -6%;
    bottom: -8%;
    width: 42%;
    height: auto;
    aspect-ratio: 1;
    color: var(--co-white);
    opacity: 0.5;
    pointer-events: none;
  }
  .tile--pale .tile__watermark { color: var(--co-blue); opacity: 0.4; }

  .tile__top {
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  /* Quieter than the chip beside it, but by colour, not by alpha: this was white at
     opacity .72, which is exactly what rule 3 forbids — and over a photograph the
     fade took it to 1.8:1. */
  .tile__num {
    font: 600 11px/1 var(--co-font-body);
    letter-spacing: var(--co-label-tracking);
    font-variant-numeric: tabular-nums;
    color: var(--co-pale);
  }
  .tile--pale .tile__num { color: var(--co-deep-text); }

  /* On a photograph no scrim keeps 11px type legible over every pixel — snow, sky and
     a lit lobby all sit at the top of these shots, and the translucent chip measured
     1.9 to 3.4:1 against the 4.5 small text needs. So on photo tiles number and chip
     share one opaque white pill, the same white as the arrow button opposite it. */
  .tile--photo .tile__top {
    align-self: flex-start;
    gap: 10px;
    padding: var(--co-label-pill-padding);
    border-radius: var(--co-radius-pill);
    background: var(--co-white);
  }
  .tile--photo .tile__num { color: var(--co-deep-text); }
  .tile--photo .tile__chip {
    padding: 0;
    background: none;
    color: var(--co-ink);
  }
  .tile__chip {
    border-radius: var(--co-radius-pill);
    padding: var(--co-label-pill-padding);
    font: 600 11px/1 var(--co-font-body);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    background: var(--co-on-dark-pill-bg);
    color: var(--co-white);
  }
  .tile--pale .tile__chip {
    background: var(--co-white);
    color: var(--co-blue);
  }

  .tile > :global(.photo),
  .tile > .co-scrim,
  .tile > .tile__watermark,
  .tile.co-grain::before {
    z-index: -1;
  }

  .tile__body {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 8px;
  }
  .tile__title {
    /* Gutter plus the tile's own padding, both sides; see .co-fit in global.css. A
       tile runs the full width only on a phone, which is the only place the cap
       can bite. At 280px the feature tile's 26px "Treppenhausreinigung" needed 256px
       of a 216px column. */
    --co-fit-inset: calc(2 * (var(--co-page-padding) + clamp(22px, 2.4vw, 32px)));
    font: 600 min(var(--co-h3-card-size), var(--co-fit)) / 1.12 var(--co-font-heading);
    letter-spacing: var(--co-h3-tracking);
    /* The measure belongs on the running text, not on the pair. It used to sit on
       .tile__body — 34ch at the 15px body size, about 272px — which also capped the
       40px feature heading, so "Treppenhausreinigung" could not fit on one line even
       inside a 900px tile and global.css's overflow-wrap: break-word snapped it to
       "Treppenhausre | inigung": mid-syllable, no hyphen, and it read as broken.
       ch scales with this element's own font-size, so 24ch is ~480px here and holds
       the longest service name on one line. */
    max-width: 24ch;
    /* Safety net only, for a genuinely narrow column: with lang="de" a browser that
       ships German hyphenation breaks at a real boundary and shows the hyphen.
       Headless Chromium carries no dictionary, so this cannot be relied on — the
       max-width above is what actually fixes the feature tile. */
    hyphens: auto;
  }
  .tile--feature .tile__title { font-size: min(clamp(26px, 3vw, 40px), var(--co-fit)); }
  .tile__title a { color: inherit; }
  /* The whole tile is the link. This overlay is meant to cover the tile, and it did
     not: .tile__body was position:relative (to lift the text over the scrim), which
     made the body its containing block, so only the title and teaser were clickable.
     The photograph, the chip and the ↗ button that plainly invites a tap all did
     nothing — on a phone, most of the tile. The text now clears the scrim through
     z-index -1 on the layers beneath it instead, and nothing between the tile and this
     overlay is positioned. */
  .tile__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .tile__text {
    font: 400 15px/1.45 var(--co-font-body);
    color: var(--co-pale);
    max-width: 34ch;
  }
  .tile--pale .tile__text { color: var(--co-deep-text); }

  .tile__arrow {
    position: absolute;
    top: clamp(22px, 2.4vw, 32px);
    right: clamp(22px, 2.4vw, 32px);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: var(--co-radius-pill);
    background: var(--co-white);
    color: var(--co-ink);
    transition: background-color 220ms ease, transform 260ms ease;
    /* Drawn over the link overlay, so a tap on it has to fall through to the link. */
    pointer-events: none;
  }
  .tile.is-linked:hover .tile__arrow {
    background: var(--co-cyan);
    transform: translate(2px, -2px);
  }
</style>
