---
import Photo from '../ui/Photo.astro';
import type { Service } from '../../data/services';

interface Props {
  service: Service;
  /** Where the whole card links. Omitted for draft services, which render as tiles. */
  href?: string;
}
const { service, href } = Astro.props;
---

<article class:list={['co-card--l co-card--blue service-card', href && 'is-linked']} id={service.slug}>
  <Photo slot={service.photoSlot} sizes="(max-width: 700px) 100vw, 33vw" />
  <!-- Not decoration: card text on the flat blue ground measures 4.02:1, under AA.
       Over the scrim it is 12.2:1. Never render this card without it. -->
  <div class="co-scrim" aria-hidden="true"></div>

  <div class="service-card__top">
    <span class="service-card__chip">{service.chip}</span>
    <span class="service-card__arrow" aria-hidden="true">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
        stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M7 17 17 7M9 7h8v8"></path>
      </svg>
    </span>
  </div>

  <div class="service-card__body">
    <h3 class="service-card__title">
      {href ? <a href={href}>{service.title}</a> : service.title}
    </h3>
    <p class="service-card__text">{service.text}</p>
  </div>
</article>

<style>
  .service-card {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: clamp(300px, 26vw, 370px);
  }
  .service-card__top {
    position: relative;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 10px;
    padding: 16px;
  }
  .service-card__chip {
    background: var(--co-white);
    color: var(--co-ink);
    border-radius: var(--co-radius-pill);
    padding: var(--co-label-pill-padding);
    font: 600 12px/1 var(--co-font-body);
  }
  .service-card__arrow {
    flex: none;
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: var(--co-radius-pill);
    background: var(--co-white);
    color: var(--co-ink);
    transition: background-color 150ms ease;
  }
  .service-card.is-linked:hover .service-card__arrow {
    background: var(--co-cyan);
  }
  .service-card__body {
    position: relative;
    display: grid;
    gap: 6px;
    padding: 18px 20px 22px;
  }
  .service-card__title {
    font: 600 var(--co-h3-card-size) / 1.15 var(--co-font-heading);
    letter-spacing: var(--co-h3-tracking);
    color: var(--co-white);
  }
  /* One link per card, stretched over the whole tile: a full-size hit target with a
     meaningful accessible name, instead of five identical tiny "Anfragen" arrows. */
  .service-card__title a {
    color: inherit;
  }
  .service-card__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .service-card__title a:hover {
    color: var(--co-ice);
  }
  .service-card__text {
    font: 400 var(--co-card-body-size) / 1.45 var(--co-font-body);
    color: var(--co-pale);
    max-width: 280px;
  }
</style>
