---
import Button from '../ui/Button.astro';
import DraftNote from '../ui/DraftNote.astro';
import ServiceIcon from '../ui/ServiceIcon.astro';
import Photo from '../ui/Photo.astro';
import type { Service } from '../../data/services';
import { getPhoto } from '../../data/photos';

/** One anchored service, as an editorial row rather than a card. Rows alternate which
 *  side carries the photograph and the scope list, so a page of eight reads as a
 *  document with a rhythm instead of a grid that repeats. */
interface Props {
  service: Service;
  index: number;
}
const { service, index } = Astro.props;
const flipped = index % 2 === 1;

/** Only a real photograph gets a frame here. A BrandPanel between seven photos would
 *  read as the one image that failed to load, so a service without a photo simply
 *  keeps the scope card on its own, as every row did before the photos arrived. */
const hasPhoto = Boolean(getPhoto(service.photoSlot).image);
---

<article class:list={['service-row', flipped && 'is-flipped']} id={service.slug}>
  <div class="service-row__main">
    <p class="co-kicker">
      {/* --item: this counts rows in the catalogue, not sections in the page. Same
          type treatment, different meaning — and it is what lets
          tests/responsive.spec.ts assert that no two sections claim one number. */}
      <span class="co-kicker__num co-kicker__num--item">
        {String(index + 1).padStart(2, '0')}
      </span>
      {service.chip}
    </p>

    <h2 class="service-row__title">
      <ServiceIcon name={service.icon} />
      {service.title}
    </h2>

    <p class="service-row__text">{service.text}</p>

    <p class="service-row__detail">{service.detail}</p>

    <p class="service-row__turnus">
      <span class="service-row__turnus-label">Turnus</span>
      {service.turnus}
    </p>

    {service.draft && <DraftNote what={`Beschreibung und Leistungsumfang „${service.title}"`} />}

    <!-- The enquiry CTA carries the service it sits under, so the form opens with this
         chip already chosen. Someone who reads about Gartenpflege and then asks for a
         quote should not have to name it again two clicks later. -->
    <div class="service-row__actions">
      {service.href ? (
        <Button href={service.href} variant="primary" arrow>Mehr zur Leistung</Button>
      ) : (
        <Button href={`/kontakt?leistung=${service.slug}#anfrage`} variant="quiet" arrow>
          Angebot anfordern
        </Button>
      )}
    </div>
  </div>

  <div class="service-row__aside">
    {
      hasPhoto && (
        <div class="service-row__photo">
          <Photo slot={service.photoSlot} sizes="(max-width: 760px) 100vw, 45vw" />
        </div>
      )
    }

    <div class="service-row__scope">
      <p class="service-row__scope-label">Leistungsumfang</p>
      <ul class="service-row__list">
        {
          service.scope.map((item) => (
            <li class="service-row__item">
              <span class="service-row__dot" aria-hidden="true" />
              <span>{item}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</article>

<style>
  .service-row {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(24px, 4vw, 64px);
    align-items: flex-start;
    padding: clamp(30px, 4vw, 56px) 0;
    scroll-margin-top: 110px;
  }
  .service-row + .service-row {
    border-top: var(--co-rule);
  }
  /* Alternating: the scope list swaps sides row to row. */
  .service-row.is-flipped {
    flex-direction: row-reverse;
  }

  .service-row__main {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
    flex: 1 1 min(420px, 100%);
    min-width: 0;
  }
  .service-row__title {
    display: flex;
    align-items: center;
    gap: 14px;
    font: 600 clamp(24px, 2.8vw, 38px) / 1.08 var(--co-font-heading);
    letter-spacing: var(--co-h3-tracking);
  }
  /* The lead sat at 42ch while the paragraph under it runs to 62, so the summary broke
     to two lines above a wider block. A lead narrower than its own body reads as a
     mistake; it now shares the measure and keeps only its larger type. */
  .service-row__text {
    font: 400 clamp(16px, 1.35vw, 19px) / 1.55 var(--co-font-body);
    color: var(--co-ink);
    max-width: 62ch;
  }
  /* The paragraph that makes the row a page rather than an index entry. Measure held
     under 70ch: tests/responsive.spec.ts caps running prose at 95ch. */
  .service-row__detail {
    max-width: 62ch;
    font: 400 var(--co-body-size) / var(--co-body-lh) var(--co-font-body);
    color: var(--co-muted);
    text-wrap: pretty;
  }

  .service-row__turnus {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 10px;
    font: 400 15px/1.4 var(--co-font-body);
    color: var(--co-ink);
  }
  .service-row__turnus-label {
    font: 600 11px/1 var(--co-font-body);
    letter-spacing: var(--co-label-tracking);
    text-transform: uppercase;
    color: var(--co-deep-text);
  }
  .service-row__actions {
    margin-top: 6px;
  }

  /* Photograph and scope card stacked as two cards with the site's card gutter
     between them — the same relation the page's own sections have to each other. */
  .service-row__aside {
    flex: 1 1 min(320px, 100%);
    min-width: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--co-card-gap);
  }
  /* 16:10 against a 16:9 source: a little off the sides, nothing off the top, where
     the heads are. The radius matches the scope card directly beneath it rather than
     --co-radius-photo, because two stacked cards 2px apart in their corners read as a
     mistake, not as two tiers. */
  .service-row__photo {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 10;
    border-radius: var(--co-radius-l);
    background: var(--co-mist);
  }

  .service-row__scope {
    min-width: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
    background: var(--co-mist);
    border-radius: var(--co-radius-l);
    padding: clamp(22px, 2.4vw, 32px);
  }
  .service-row__scope-label {
    font: 600 11px/1 var(--co-font-body);
    letter-spacing: var(--co-label-tracking);
    text-transform: uppercase;
    color: var(--co-deep-text);
  }
  .service-row__list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 12px;
  }
  .service-row__item {
    display: flex;
    align-items: flex-start;
    gap: 11px;
    font: 400 16px/1.45 var(--co-font-body);
    color: var(--co-ink);
  }
  .service-row__dot {
    flex: none;
    width: 6px;
    height: 6px;
    margin-top: 9px;
    border-radius: var(--co-radius-pill);
    background: var(--co-blue);
  }
</style>
