---
import Button from '../ui/Button.astro';
import DraftNote from '../ui/DraftNote.astro';
import type { Service } from '../../data/services';

interface Props {
  service: Service;
}
const { service } = Astro.props;
---

<article class="co-card--l service-section" id={service.slug}>
  <div class="service-section__head">
    <span class="service-section__chip">{service.chip}</span>
    <h3 class="service-section__title">{service.title}</h3>
  </div>

  <p class="service-section__text">{service.text}</p>

  <ul class="service-section__scope">
    {
      service.scope.map((item) => (
        <li class="service-section__item">
          <span class="service-section__dot" aria-hidden="true" />
          <span>{item}</span>
        </li>
      ))
    }
  </ul>

  <p class="service-section__turnus">
    <span class="service-section__turnus-label">Turnus</span>
    {service.turnus}
  </p>

  {service.draft && <DraftNote what={`Beschreibung und Leistungsumfang „${service.title}"`} />}

  <div class="service-section__actions">
    {
      service.href ? (
        <Button href={service.href} variant="primary">Mehr zur Treppenhausreinigung</Button>
      ) : (
        <Button href="/kontakt" variant="quiet">Angebot anfordern</Button>
      )
    }
  </div>
</article>

<style>
  .service-section {
    display: grid;
    gap: 14px;
    align-content: start;
    grid-template-rows: auto auto 1fr auto auto;
    background: var(--co-white);
    border: 1px solid var(--co-line);
    padding: var(--co-small-card-padding);
    scroll-margin-top: 90px;
  }
  .service-section__head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
  }
  .service-section__title {
    font: 600 var(--co-h3-card-size) / 1.15 var(--co-font-heading);
    letter-spacing: var(--co-h3-tracking);
  }
  .service-section__chip {
    background: var(--co-mist);
    color: var(--co-blue);
    border-radius: var(--co-radius-pill);
    padding: var(--co-label-pill-padding);
    font: 600 11px/1 var(--co-font-body);
    letter-spacing: var(--co-label-tracking);
    text-transform: uppercase;
  }
  .service-section__text {
    font: 400 var(--co-body-size) / var(--co-body-lh) var(--co-font-body);
    color: var(--co-muted);
  }
  .service-section__scope {
    display: grid;
    gap: 11px;
  }
  .service-section__item {
    display: flex;
    align-items: flex-start;
    gap: 11px;
    font: 400 15px/1.45 var(--co-font-body);
  }
  .service-section__dot {
    flex: none;
    width: 6px;
    height: 6px;
    margin-top: 8px;
    border-radius: var(--co-radius-pill);
    background: var(--co-blue);
  }
  .service-section__turnus {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: baseline;
    border-top: 1px solid var(--co-line);
    padding-top: 14px;
    font: 400 15px/1.4 var(--co-font-body);
    color: var(--co-ink);
  }
  .service-section__turnus-label {
    font: 600 11px/1 var(--co-font-body);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--co-blue);
  }
  .service-section__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 10px;
    margin-top: auto;
    padding-top: 4px;
  }
</style>
