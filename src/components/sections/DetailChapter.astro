---
import Button from '../ui/Button.astro';
import Photo from '../ui/Photo.astro';
import InfoCard from './InfoCard.astro';
import { detail } from '../../data/content';
import { resolveHref } from '../../data/routes';
import { fitStyle } from '../../lib/fit';

interface Props {
  /** Was how the homepage showed one paragraph while the deep service page showed all
   *  three. That page is gone: the site is four pages, so the homepage is now the only
   *  place this chapter exists and it renders in full. The prop stays because the
   *  component still supports it, but nothing passes it. */
  condensed?: boolean;
  level?: 1 | 2;
  id?: string;
}
const { condensed = false, level = 2, id = 'treppenhaus' } = Astro.props;

const paragraphs = condensed ? detail.paragraphs.slice(0, 1) : detail.paragraphs;
const Heading = level === 1 ? 'h1' : 'h2';
---

<section class="co-card co-card--white detail" id={id}>
  <!-- Heading large in a left column, running text right — the references' "Meet USD
       Halo." split, instead of a symmetric 1fr 1fr. -->
  <div class="detail__head">
    <div class="detail__head-main">
      <p class="co-kicker"><span class="co-kicker__num">02</span> {detail.pill}</p>
      <Heading class:list={['detail__heading', 'co-fit', level === 1 && 'is-h1']} style={fitStyle(detail.h2)}>{detail.h2}</Heading>
    </div>
    <p class="detail__lede">{paragraphs[0]}</p>
  </div>

  <div class:list={['detail__grid', condensed && 'is-condensed']}>
    <div class="detail__text">
      {paragraphs.slice(1).map((p) => <p class="detail__para">{p}</p>)}

      {
        /* On the homepage the body paragraphs move up into the lede, which left this
           column holding nothing but two buttons beside a 360px photo — a void with
           the CTAs floating in the middle of it. The scope list is the substance a
           reader wants at exactly this point ("what do I actually get?"), and it is
           already in the data. */
        condensed && (
          <div class="detail__scope">
            <p class="co-kicker">{detail.infoCard.label}</p>
            <ul class="detail__scope-list">
              {detail.infoCard.items.map((item) => (
                <li class="detail__scope-item">{item}</li>
              ))}
            </ul>
          </div>
        )
      }

      <div class="detail__actions">
        {
          detail.ctas.map((cta) => (
            <Button
              href={condensed && cta.style === 'quiet' ? '/leistungen' : resolveHref(cta.href)}
              variant={cta.style === 'primary' ? 'primary' : 'quiet'}
            >
              {cta.label}
            </Button>
          ))
        }
      </div>
    </div>

    <div class="detail__aside">
      <div class="detail__photo">
        <Photo slot={detail.photo.slot} sizes="(max-width: 900px) 100vw, 45vw" />
      </div>
      {
        !condensed && (
          <InfoCard
            label={detail.infoCard.label}
            items={detail.infoCard.items}
            facts={detail.infoCard.facts}
          />
        )
      }
    </div>
  </div>
</section>

<style>
  .detail {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(30px, 4vw, 54px);
  }
  .detail__head {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(24px, 4vw, 64px);
    align-items: flex-end;
  }
  .detail__head-main {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 18px;
    flex: 1 1 min(520px, 100%);
    min-width: 0;
  }
  .detail__lede {
    flex: 1 1 min(400px, 100%);
    min-width: 0;
    /* Ran to ~100ch at 900px without this. */
    max-width: 52ch;
    font: 400 clamp(16px, 1.35vw, 19px) / 1.55 var(--co-font-body);
    color: var(--co-muted);
  }
  .detail__grid {
    display: flex;
    flex-wrap: wrap;
    gap: var(--co-two-col-gap);
    align-items: flex-start;
  }
  .detail__text { flex: 1 1 min(460px, 100%); min-width: 0; }
  .detail__aside { flex: 1 1 min(440px, 100%); min-width: 0; }

  /* Condensed (home): the text column carries the scope list, so both sides have
     weight and the row aligns at the top rather than centring two buttons in a void. */
  .is-condensed .detail__text { flex: 1 1 min(380px, 100%); }
  .is-condensed .detail__aside { flex: 1 1 min(480px, 100%); }

  .detail__scope {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 14px;
    width: 100%;
  }
  .detail__scope-list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0;
  }
  .detail__scope-item {
    padding-block: 11px;
    border-top: var(--co-rule);
    font: 400 16px/1.4 var(--co-font-body);
    color: var(--co-ink);
  }
  .detail__scope-item:first-child { border-top: 0; padding-top: 0; }
  .detail__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
  }
  .detail__para:first-of-type { margin-top: 0; }
  .detail__heading {
    /* Gutter plus card padding, both sides; see .co-fit in global.css. At 280px
       "Treppenhausreinigung" was 8px wider than the column at the h2 floor. */
    --co-fit-inset: calc(2 * (var(--co-page-padding) + var(--co-section-padding)));
    font: 700 min(var(--co-h2-size), var(--co-fit)) / 1.1 var(--co-font-heading);
    letter-spacing: var(--co-h2-tracking);
    margin-bottom: 4px;
  }
  .detail__heading.is-h1 {
    font-size: min(var(--co-h1-size), var(--co-fit));
    line-height: 1.06;
    letter-spacing: var(--co-h1-tracking);
  }
  .detail__para {
    font: 400 var(--co-body-size) / var(--co-body-lh) var(--co-font-body);
    color: var(--co-muted);
    max-width: 68ch;
  }
  .detail__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 12px;
  }
  .detail__aside { display: grid; gap: var(--co-grid-gap); }
  /* 16:10, held between 240 and 420px tall. This was a fixed clamp(240px, 26vw,
     360px) height, drawn while the slot held a BrandPanel, which has no subject to
     lose. Below 1180px the aside wraps under the text and runs the card's full width,
     and that height made the frame 2.85:1 on a tablet and 3.43:1 on a laptop: a
     photograph of a man climbing stairs kept either his head or the basket he
     carries, never both. Now the flattest the frame gets is 2.2:1, at 1024px.
     The explicit width matters: a grid item with an aspect-ratio is not stretched,
     so without it the 420px cap narrowed the frame and the 240px floor pushed it
     past the card's edge on a phone. */
  .detail__photo {
    position: relative;
    overflow: hidden;
    width: 100%;
    aspect-ratio: 16 / 10;
    min-height: 240px;
    max-height: 420px;
    border-radius: var(--co-radius-photo);
    box-shadow: var(--co-shadow-card);
  }
</style>
