---
import Logo from './ui/Logo.astro';
import { company } from '../data/company';
import { footer } from '../data/content';
import { legalNav } from '../data/nav';
---

<footer class="co-card co-card--ink co-grain site-footer">
  <p class="site-footer__wordmark" aria-hidden="true">CO Gebäudeservice</p>

  <div class="site-footer__top">
    <div class="site-footer__brand">
      <Logo href="/" tone="onDark" variant="lockup" height={78} />
      <p class="site-footer__blurb">{footer.blurb}</p>
    </div>

    <address class="site-footer__address">
      {company.address.display}<br />
      {
        company.phone.verified ? (
          <a href={`tel:${company.phone.e164}`}>{company.phone.display}</a>
        ) : (
          company.phone.display
        )
      }<br />
      {
        company.email.verified ? (
          <a href={`mailto:${company.email.display}`}>{company.email.display}</a>
        ) : (
          company.email.display
        )
      }
    </address>
  </div>

  <div class="site-footer__bottom">
    <span>{footer.meta}</span>
    <nav class="site-footer__legal" aria-label="Rechtliches">
      {legalNav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    overflow: hidden;
    padding: clamp(28px, 3.4vw, 44px);
    /* The WhatsApp button floats 56px tall in the bottom-right corner and was cutting
       into the end of "Datenschutz" when the page is scrolled to the foot. The link
       stayed clickable, but a legally required link should not sit under a button.
       Room for the button plus its own gutter. */
    padding-bottom: calc(clamp(28px, 3.4vw, 44px) + 56px + var(--co-page-padding));
  }
  /* Oversized wordmark as a ground, as both references close with. */
  .site-footer__wordmark {
    font: 700 clamp(38px, 8.4vw, 130px) / 0.9 var(--co-font-heading);
    letter-spacing: -0.05em;
    color: var(--co-ice);
    opacity: 0.11;
    margin-bottom: clamp(20px, 3vw, 42px);
    pointer-events: none;
    user-select: none;
    text-wrap: nowrap;
  }
  .site-footer__top,
  .site-footer__bottom { position: relative; }
  .site-footer__top {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 28px;
    padding-bottom: 28px;
    border-bottom: 1px solid var(--co-on-dark-divider);
  }
  /* The signature and the line under it read as one block, so they travel together
     when the row wraps instead of the text drifting under the address column. */
  .site-footer__brand {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
    flex: 1 1 min(380px, 100%);
    min-width: 0;
  }
  .site-footer__blurb {
    max-width: 44ch;
    font: 400 15px/1.6 var(--co-font-body);
    color: var(--co-pale);
    text-wrap: pretty;
  }

  .site-footer__address {
    font: 400 16px/1.75 var(--co-font-body);
    font-style: normal;
    color: var(--co-pale);
  }
  .site-footer__address a {
    color: var(--co-cyan);
  }
  .site-footer__address a:hover {
    color: var(--co-ice);
  }
  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
    padding-top: 22px;
    font: 400 13px/1.5 var(--co-font-body);
    color: var(--co-ice);
  }
  .site-footer__legal {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .site-footer__legal a {
    color: var(--co-ice);
  }
  .site-footer__legal a:hover {
    color: var(--co-white);
  }
</style>
