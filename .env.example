# Canonical origin. Also used for the sitemap and OG URLs.
PUBLIC_SITE_URL="https://co-gebaeudeservice.de"

# The launch gate, now open. "true" — which is also what an absent variable means —
# gives index, follow plus a robots.txt that allows everything and names the sitemap.
# Set it to "false" on a preview environment, or to take the site back out of search.
PUBLIC_SITE_INDEXABLE="true"

# Preview-only banners marking copy the client has not approved. Opt-in: anything other
# than "true" hides them, so a deploy that forgets this variable does not show "Entwurf"
# to a visitor. Set it to "true" for your own review passes.
PUBLIC_SHOW_DRAFT_NOTES="false"

# Empty = the form validates, then refuses and points at Telefon and WhatsApp, because
# an enquiry it cannot deliver must not be confirmed. Set it to "/api/kontakt" to POST
# to the Resend endpoint — but only together with the three server-side variables below,
# or every send is answered with 503 and the visitor sees a failure.
PUBLIC_FORM_ENDPOINT=""

# --- Server-side only. Never prefixed PUBLIC_, so these never reach the browser. -----
# Set these in the Vercel project settings, not in a committed file.

# https://resend.com/api-keys
RESEND_API_KEY=""

# Where enquiries are delivered — the client's real inbox.
CONTACT_TO=""

# The From address. Its domain must be verified in Resend first, otherwise every send
# is rejected. Use a subdomain you control, e.g. "Website <noreply@co-gebaeudeservice.de>".
CONTACT_FROM=""
