# Canonical origin. Also used for the sitemap and OG URLs.
PUBLIC_SITE_URL="https://www.co-gebaeudeservice.de"

# The launch gate. While this is not "true" every page is noindex and robots.txt
# disallows everything. Flip only when: real phone + email are in src/data/company.ts,
# the legal pages are signed off, and the form endpoint is live.
PUBLIC_SITE_INDEXABLE="false"

# Preview-only banners marking copy the client has not approved.
PUBLIC_SHOW_DRAFT_NOTES="true"

# Empty = the contact form validates and confirms locally without sending.
# Set to "/api/kontakt" once the Resend endpoint exists.
PUBLIC_FORM_ENDPOINT=""
